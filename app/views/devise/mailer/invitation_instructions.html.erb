<p>Hello <%= @resource.email %>,</p>

<p>You have been invited to join <%= Rails.application.class.module_parent_name %>!</p>

<p>
  To accept the invitation, click the link below:
</p>

<p>
  <%= link_to "Accept Invitation", accept_user_invitation_url(invitation_token: @token) %>
</p>

<p>If you did not expect this invitation, you can safely ignore this email.</p>
