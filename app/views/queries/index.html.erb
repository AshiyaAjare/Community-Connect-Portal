<h1 class="my-4 text-center">Queries</h1>
<div class="input-group rounded mb-4">
  <%= form_with url: queries_path, method: :get, local: true, class: "d-flex" do %>
    <%= text_field_tag :search, params[:search], class: "form-control rounded", placeholder: "Search", aria: { label: "Search", describedby: "search-addon" } %>
    <%= submit_tag "Search", class: "btn btn-outline-primary ms-2" %>
  <% end %>
</div>
<div class="table-responsive">
  <table class="table table-hover table-bordered shadow-sm">
    <thead class="table-dark">
      <tr>
        <th>Title</th>
        <th>Tags</th>
        <th>Responses Count</th>
        <th>Created By</th>
        <th>Status</th>
        <th>Flagged</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="query_table_body">
      <%= render partial: 'queries/query', collection: @queries, as: :query %>  
    </tbody>
  </table>
</div>
