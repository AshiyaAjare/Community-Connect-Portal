<tr id="query_<%= query.id %>">
  <td>
    <%= link_to query.title, query, class: "text-decoration-none fw-bold" %>
  </td>
  <td>
    <span class="badge bg-primary"><%= query.tags.map(&:name).join("</span> <span class='badge bg-primary'>").html_safe.presence || "No Tags" %></span>
  </td>
  <td class="text-center"><%= query.responses.count %></td>
  <td><%= query.user.first_name %> <%= query.user.last_name %></td>
  
  <!-- Status Toggle -->
  <td class="text-center">
    <% if current_user.admin_user? %>
      <%= button_to query.status ? "Close" : "Open",
        update_status_query_path(query),
        method: :patch,
        data: { turbo_confirm: "Are you sure you want to change the status?", turbo_method: :patch  },
        class: "btn btn-sm #{query.status ? 'btn-danger' : 'btn-success'}" %>
    <% else %>
      <span class="badge <%= query.status ? 'bg-success' : 'bg-danger' %>">
        <%= query.status ? "Open" : "Closed" %>
      </span>
    <% end %>
  </td>
 
  <!-- Flag Toggle -->
  <td class="text-center">
    <% if current_user.admin_user? %>
      <%= button_to query.flagged ? "Unflag" : "Flag",
        update_flag_query_path(query),
        method: :patch,
        data: { turbo_confirm: "Are you sure you want to flag this query?", turbo_method: :patch  },
        class: "btn btn-sm #{query.flagged ? 'btn-warning' : 'btn-secondary'}" %>
    <% else %>
      <span class="badge <%= query.flagged ? 'bg-warning' : 'bg-secondary' %>">
        <%= query.flagged ? "Flagged" : "Not Flagged" %>
      </span>
    <% end %>
  </td>

  <!-- Actions -->
  <td>
    <% if current_user.admin_user? %>
      <%= button_to 'Delete', query, method: :delete, 
        data: { turbo_confirm: 'Are you sure you want to delete this query?' }, 
        class: "btn btn-danger btn-sm" %>
    <% else %>
      <%= link_to 'Edit', edit_query_path(query), class: "btn btn-primary btn-sm mx-1" %>
      <%= button_to 'Delete', query, method: :delete, 
        data: { turbo_confirm: 'Are you sure you want to delete this query?' }, 
        class: "btn btn-danger btn-sm" %>
    <% end %>
  </td>
</tr>
