<div class="container mt-4">
  <h2 class="fw-bold"><%= @query.title %></h2>
  <p class="text-muted">Posted by <%= @query.user.first_name %> <%= @query.user.last_name %></p>
  
  <div class="mb-3">
    <strong>Tags:</strong>
    <span class="badge bg-primary"><%= @query.tags.map(&:name).join('</span> <span class="badge bg-primary">').html_safe.presence || "No Tags" %></span>
  </div>
  
  <div class="card mb-4">
    <div class="card-body">
      <p><%= @query.content %></p>
    </div>
  </div>
  
  <div class="d-flex mb-3">
    <% if current_user.admin_user? %>
      <%= button_to @query.status ? "Close" : "Open", update_status_query_path(@query), method: :patch, data: { turbo_confirm: "Are you sure you want to change the status?" }, class: "btn #{ @query.status ? 'btn-danger' : 'btn-success' } btn-sm mx-1" %>
      <%= button_to @query.flagged ? "Unflag" : "Flag", update_flag_query_path(@query), method: :patch, data: { turbo_confirm: "Are you sure you want to flag this query?" }, class: "btn #{ @query.flagged ? 'btn-warning' : 'btn-secondary' } btn-sm mx-1" %>
    <% end %>
    <span class="badge <%= @query.status ? 'bg-success' : 'bg-danger' %> mx-1">
      <%= @query.status ? "Open" : "Closed" %>
    </span>
    <span class="badge <%= @query.flagged ? 'bg-warning' : 'bg-secondary' %>">
      <%= @query.flagged ? "Flagged" : "Not Flagged" %>
    </span>
  </div>
  
  <h4>Responses (<%= @query.responses.count %>)</h4>
  <% if @query.responses.any? %>
    <div class="list-group">
      <% @query.responses.each do |response| %>
        <div class="list-group-item">
          <p><%= response.content %></p>
          <small class="text-muted">By <%= response.user.first_name %> <%= response.user.last_name %></small>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No responses yet.</p>
  <% end %>
</div>
