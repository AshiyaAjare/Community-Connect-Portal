<div class="container mt-5">
  <div class="row justify-content-between align-items-center mb-4">
    <div class="col-auto">
      <h2 class="fw-bold">Tags</h2>
    </div>

  </div>

  <div class="table-responsive">  
    <table class="table table-striped table-hover text-center align-middle shadow-sm">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Tag</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td><%= tag.id %></td>
            <td><%= tag.name %></td>
            <td>
              <%= button_to "Delete", tag_path(tag), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm", form: { onsubmit: "return confirm('Are you sure?');" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <div>
</div>