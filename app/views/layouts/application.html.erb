<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Community Connect Exp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= turbo_stream_from current_user if user_signed_in? %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+6Bam5b4b91+1e5z5t5g5t5g5t5g5" crossorigin="anonymous"></script>
    
    <style>
      body {
        background-color: white; /* Light yellow background */
      }
      .navbar {
        background-color:rgb(161, 220, 252); /* Light blue navbar */
        height: 60px;
      }
      .sidebar {
        background-color: rgb(161, 220, 252); /* Matching navbar color */
        width: 0; /* Start hidden */
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        overflow: hidden; /* Hide contents when collapsed */
        transition: width 0.3s ease-in-out;
        white-space: nowrap; /* Prevent text wrapping */
      }

      .sidebar.show {
        width: 250px; /* Expand when shown */
        padding: 20px; /*Restore padding when visible */
      }

      .sidebar .nav-link {
        background-color: #f8f9fa;
        color: black;
        margin-bottom: 10px;
        border-radius: 5px;
        text-align: center;
      }
      .sidebar .nav-link:hover {
        background-color: #e9ecef;
      }
      .logout-btn {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: 80%;
      }
      .content {
        width: calc(100% - 250px);
        margin: 0 auto;
        transition: width 0.3s;
        padding: 20px;
      }
      .content.full-width {
        width: 100%;
      }
      .toggle-btn {
        cursor: pointer;
        font-size: 24px;
        margin-left: 10px;
        color: black;
        display: block;
        z-index:2;
      }
      .user-info {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      /* Flash messages */
      .flash-messages {
        position: fixed;
        top: 10px; 
        left: 50%;
        transform: translateX(-50%);
        z-index: 1050; 
        width: auto;
        max-width: 80%;
        padding: 10px 20px;
        border-radius: 5px;
      }

    </style>

  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg px-3">
      <span id="toggle-btn" class="toggle-btn" onclick="toggleSidebar()">☰</span>
      <span class="fw-bold fs-3 ms-2">LinkUp</span>
      <div class="ms-auto user-info">
      <% if user_signed_in? %>
        <li class="nav-item dropdown d-flex align-items-center gap-2">
        <%= image_tag(current_user.display_profile_image_url, class: "rounded-circle border", width: 40, height: 40, id: "userDropdown", role: "button", data: { bs_toggle: "dropdown" }) %>
        <div class="text-dark fw-bold">
          <%= current_user.first_name %> <%= current_user.last_name %><br>
          <span class="small text-muted"><%= current_user.email %></span>
        </div>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li><%= link_to "View Profile", user_path(current_user), class: "dropdown-item" %></li>
          <li><%= link_to "Update Profile", edit_user_registration_path, class: "dropdown-item" %></li>
        </ul>
        </li>
      <% else %>
        <%= link_to "Log In", new_user_session_path, class: "btn btn-success" %>
      <% end %>
      </div>
    </nav>

    <div class="d-flex">
      <!-- Sidebar -->
      <nav id="sidebar" class="sidebar">
        <h4 class="text-center">Dashboard</h4>
        <hr>
        <% if user_signed_in? %>
          <ul class="nav flex-column">
            <li class="nav-item">
              <%= link_to "Users", users_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Queries", queries_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Responses", responses_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Moderation Logs", moderation_logs_path, class: "nav-link" %>
            </li>
          </ul>

          <!-- Log Out Button at Bottom -->
          <div class="logout-container">
            <%= form_with url: destroy_user_session_path, method: :delete, local: true do %>
              <%= submit_tag "Log Out", class: "btn btn-danger logout-btn" %>
            <% end %>
          </div>

        <% else %>
          <p class="text-center">Please log in</p>
        <% end %>
      </nav>


      <!-- Main Content -->
      <div class="flash-messages position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 1100;">
        <% flash.each do |type, message| %>
          <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      </div>

      <div id="content" class="content">
        <%= yield %> <!-- Page Content -->
      </div>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
      let sidebar = document.querySelector(".sidebar");
      sidebar.classList.remove("show"); // Ensure it's hidden on page load
    });

    function toggleSidebar() {
      let sidebar = document.querySelector(".sidebar");
      sidebar.classList.toggle("show"); // Toggle visibility
    }

    </script>
  </body>
</html>
