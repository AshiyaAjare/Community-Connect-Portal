<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Community Connect Exp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= turbo_stream_from current_user if user_signed_in? %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <style>
      body {
        background-color: #f4f7fc;
      }
      .navbar {
        background-color: #2f4f4f !important;
      }
      .sidebar {
        background-color: #2f4f4f;
        color: white;
      }
      .sidebar .nav-link {
        color: #d1d5db;
      }
      .sidebar .nav-link:hover {
        color: white;
      }
      .user-info {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .card {
        border: none;
        border-radius: 8px;
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark px-3">
      <a class="navbar-brand" href="#">Admin Panel</a>
      <div class="ms-auto user-info">
        <% if user_signed_in? %>
          <li class="nav-item d-flex align-items-center gap-3">
            <%= image_tag(current_user.profile_image_url, class: "rounded-circle", width: 35, height: 35) %>
            <span class="text-white"><%= current_user.first_name %> <%= current_user.last_name %>: <%= current_user.email %> </span>
          </li>
        <% else %>
          <%= link_to "Log In", new_user_session_path, class: "btn btn-success" %>
        <% end %>
      </div>
    </nav>

    <div class="d-flex">
      <!-- Sidebar -->
      <nav class="sidebar vh-100 p-3" style="width: 250px;">
        <h4 class="text-center">Dashboard</h4>
        <hr>
        <% if user_signed_in? %>
          <ul class="nav flex-column">
            <li class="nav-item">
              <%= link_to "Users List", users_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Add User", new_user_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "View Tags", tags_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "View Queries", queries_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "View Responses", responses_path, class: "nav-link" %>
            </li>
            <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'btn btn-danger' %>
          </ul>
        <% else %>
          <p class="text-center">Please log in</p>
        <% end %>
      </nav>

      <!-- Main Content -->
      <div class="flex-grow-1 p-4">
        <%= yield %> <!-- Page Content -->
      </div>
    </div>
  </body>
</html>
