<!-- app/views/users/edit.html.erb -->
<div class="container mt-5">
  <h1 class="mb-4">Edit User: <%= @user.first_name %> <%= @user.last_name %></h1>
  
  <%= form_with(model: @user, local: true) do |form| %>
    <div class="row mb-4">
      <div class="col">
        <div class="form-outline">
          <%= form.label :first_name, "First Name", class: "form-label" %>
          <%= form.text_field :first_name, class: "form-control" %>
        </div>
      </div>
      <div class="col">
        <div class="form-outline">
          <%= form.label :last_name, "Last Name", class: "form-label" %>
          <%= form.text_field :last_name, class: "form-control" %>
        </div>
      </div>
    </div>

    <div class="form-outline mb-4">
      <%= form.label :email, "Email Address", class: "form-label" %>
      <%= form.email_field :email, class: "form-control" %>
    </div>

    <div class="form-outline mb-4">
      <%= form.label :role, "Role", class: "form-label" %>
      <%= form.select :role, User.roles.keys.map { |role| [role.capitalize, role] }, { prompt: "Select Role" }, class: "form-select" %>
    </div>

    <div class="form-outline mb-4">
      <%= form.label :profile_image_url, "Profile Image URL", class: "form-label" %>
      <%= form.text_field :profile_image_url, class: "form-control" %>
    </div>

    <div class="text-center">
      <%= form.submit "Update User", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= link_to 'Back to Users', users_path, class: "btn btn-secondary mt-4" %>
</div>
