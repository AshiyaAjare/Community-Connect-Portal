<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="card" style="width: 36rem;">

    <img class="card-img-top" src="<%= @users.profile_image %>" class="rounded-circle" alt="<%= @users.first_name %>">

    <div class="card-body">
        <h5 class="card-title"><%= "#{@users.first_name} #{@users.last_name}" %></h5>
        <p class="card-text">Role: <%= @users.role.capitalize %></p>
    </div>

    <ul class="list-group list-group-flush">

        <li class="list-group-item">
        <button class="btn btn-outline-info" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit User">
            Edit Profile
        </button>
        </li>

        <li class="list-group-item">
        <button class="btn btn-outline-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete User">
            Delete Profile
        </button>
        </li>

    </ul>

    <div class="card-body">
        <%= link_to 'Back to Users', users_path %>
    </div>

    </div>
</div>