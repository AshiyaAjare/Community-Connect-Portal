<div class="container mt-5">
  <div class="row justify-content-between align-items-center mb-4">
    <div class="col-auto">
      <h2 class="fw-bold">Users List</h2>
    </div>
    
  </div>

  <!-- Turbo Frame for Users Table -->
  <turbo-frame id="users_table">
    <div class="table-responsive">
      <table class="table table-striped table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
          <tr>
            <th>Profile</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="users_table_body">
          <%= render @users %>  <!-- Renders _user.html.erb partial for each user -->
        </tbody>
      </table>
    </div>
  </turbo-frame>
</div>
