<!-- app/views/users/index.html.erb -->

<div class="container mt-5">
  <div class="row">
    <div class="col">

      <div class="d-flex justify-content-between mb-3">
        <h1>Users</h1>
        <a href="<%= new_user_path %>" class="btn btn-success ms-auto">
          Add User
        </a>
      </div>

      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th scope="col">Profile</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <%= image_tag(user.profile_image.attached? ? user.profile_image : '/assets/images/default_image.png', 
                              class: "rounded-circle", 
                              alt: user.first_name, 
                              width: 50, 
                              height: 50) %>
              </td>
              <td><%= "#{user.first_name} #{user.last_name}" %></td>
              <td><%= user.email %></td>
              <td><%= user.role.capitalize %></td>
              <td>
                <button class="btn btn-outline-info me-2" 
                        data-bs-toggle="tooltip" 
                        data-bs-placement="top" 
                        title="View Profile">
                  <%= link_to 'View', user_path(user) %>
                </button>

                <button class="btn btn-outline-primary me-2" 
                        data-bs-toggle="tooltip" 
                        data-bs-placement="top" 
                        title="Edit User">
                  <%= link_to 'Edit', edit_user_path(user) %>
                </button>

                <%= button_to 'Delete', user_path(user), 
                              method: :delete, 
                              data: { confirm: 'Are you sure you want to discard this user?' }, 
                              class: 'btn btn-outline-danger me-2' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
    </div>
  </div>
</div>
