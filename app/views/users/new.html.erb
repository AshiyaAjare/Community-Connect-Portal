<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="card shadow-lg p-4 rounded" style="width: 36rem;">
    <div class="card-body">
      <h3 class="text-center mb-4">Create User</h3>

      <%= form_with model: @user, url: users_path, method: :post, html: { multipart: true }, data: { turbo: true } do |f| %>
        <!-- Name fields -->
        <div class="row mb-3">
          <div class="col">
            <%= f.label :first_name, "First Name", class: "form-label" %>
            <%= f.text_field :first_name, class: "form-control", required: true %>
          </div>
          <div class="col">
            <%= f.label :last_name, "Last Name", class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control", required: true %>
          </div>
        </div>

        <!-- Email input -->
        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.text_field :email, class: "form-control", required: true %>
        </div>

        <!-- Password input -->
        <div class="mb-3">
          <%= f.label :password, "Password", class: "form-label" %>
          <%= f.password_field :password, class: "form-control", required: true %>
        </div>

        <!-- Role dropdown -->
        <div class="mb-3">
          <%= f.label :role, "Role", class: "form-label" %>
          <%= f.select :role, 
               [["Contributor", "contributor"], ["Moderator", "moderator"]], 
               { prompt: "Select Role" }, 
               { class: "form-select" } %>
        </div>

        <!-- Submit button -->
        <div class="d-grid">
          <%= f.submit 'Create User', class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
