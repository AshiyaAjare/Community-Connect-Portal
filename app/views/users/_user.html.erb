<!-- app/views/users/_user.html.erb -->
<% if !user.admin_user? %>
<tr id="user_<%= user.id %>">
  <td>
    <%= image_tag(current_user.display_profile_image_url, class: "rounded-circle", width: 50, height: 50) %>
  </td>

  <td><%= user.first_name %> <%= user.last_name %></td>
  <td><%= user.email %></td>
  <td><%= user.role.capitalize %></td>
  <td>
    <div class="d-flex justify-content-between">
      <%= link_to "View", user_path(user), class: "btn btn-info mr-2" %>
      <%# <%= link_to "Edit", edit_user_path(user), class: "btn btn-primary" %>  
      <%= button_to "Delete", user_path(user), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger", form: { onsubmit: "return confirm('Are you sure?');" } %>
    </div>
  </td>
  <td>
    <% if !user.invitation_sent_at && current_user.admin_user? %>
      <%= button_to "Invite", invite_user_path(user), 
            method: :post, remote: true, data: {turbo: false}, class: "btn btn-primary", 
            id: "invite-user-#{user.id}" %>
    <% else %>
      <h8>Invitation sent at: <%= user.invitation_sent_at %></h8>
    <% end %>
  </td>
  <td>
  <% if !user.invitation_accepted_at && current_user.admin_user? %>
        <%= button_to "Resend Invitation", invite_user_path(user), 
              method: :post, remote: true, data: {turbo: false}, class: "btn btn-outline-success", 
              id: "invite-user-#{user.id}" %>
      <%else%>
        <h8>Invitation accepted at: <%= user.invitation_accepted_at %></h8>
      <% end %>
  </td>
</tr>

<% end %>
